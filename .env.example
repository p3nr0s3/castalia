# Access token protecting every /api/* route (fs, tools/execute, connectors,
# db, cloud/chat, search, audio, and the Ollama proxy).
#
# Without this set, all API routes are open to anyone who can reach the port
# — fine for pure localhost dev, but NOT fine the moment scripts/tunnel.mjs
# is used to expose this app publicly.
#
# Set BOTH to the same value. APP_ACCESS_TOKEN is checked server-side by
# middleware.ts. NEXT_PUBLIC_APP_ACCESS_TOKEN is the client-visible copy the
# browser sends back — it is public by necessity (this is a client app with
# no session/cookie auth), so treat this token as a lock on the door, not a
# secret. Rotate it if you ever suspect it leaked.
#
# Generate one with: openssl rand -hex 32

APP_ACCESS_TOKEN=
NEXT_PUBLIC_APP_ACCESS_TOKEN=

# Existing Ollama config (unchanged)
OLLAMA_HOST=http://127.0.0.1:11434
