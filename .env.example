# Access token protecting every /api/* route (fs, tools/execute, connectors,
# db, cloud/chat, search, audio, and the Ollama proxy).
#
# Without this set there is no token check on the API routes — fine for pure
# localhost use (cross-site requests and foreign Host headers are rejected
# regardless), but NOT fine the moment you use `*:lan` scripts or
# scripts/tunnel.mjs (which refuses to start without it).
#
# Set BOTH to the same value. APP_ACCESS_TOKEN is checked server-side by
# middleware.ts. NEXT_PUBLIC_APP_ACCESS_TOKEN is the client-visible copy the
# browser sends back — it is public by necessity (this is a client app with
# no session/cookie auth), so treat this token as a lock on the door, not a
# secret. Rotate it if you ever suspect it leaked.
#
# Generate one with: openssl rand -hex 32

APP_ACCESS_TOKEN=
NEXT_PUBLIC_APP_ACCESS_TOKEN=

# Existing Ollama config (unchanged)
OLLAMA_HOST=http://127.0.0.1:11434

# Optional: cloud provider API keys, kept server-side instead of typed into
# Settings -> Cloud AI Providers (which stores them in browser localStorage
# and sends them in each request body). Set whichever ones you use; a
# server-side value here always takes precedence over a client-supplied one.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional: only needed if you deliberately want another origin (e.g. a
# companion app on a different device) to call this app's /api/* routes
# cross-origin from browser JS. Leave unset to keep CORS closed (default).
ALLOW_EXTERNAL_ORIGIN=

# Optional: extra hostnames this app may be served under. Requests whose Host
# header is not localhost / an IP address / a single-label LAN name / *.local /
# a Pinggy tunnel domain are rejected with 403 — that is the DNS-rebinding
# defence (see lib/requestGuard.ts). Comma-separated; "chat.example.com" exact,
# ".example.com" or "*.example.com" suffix, "*" disables the check entirely
# (not recommended).
ALLOWED_HOSTS=

# Optional: where the app keeps its private runtime data (database, caches, snapshots, bridge tokens).
# Default: ./data. The test suite points this at a throwaway folder, so `npm test` never touches your data.
LYRA_DATA_DIR=

# Optional: set to 0 to stop the daily database snapshots written to data/backups/.
LYRA_AUTO_BACKUP=

# Optional: set to 0 to run scheduled agents only in the browser. By default the server runs agents
# that do not use disk tools, so they fire even with no tab open.
LYRA_SERVER_SCHEDULER=

# Optional: how the server reaches its own API (used by the server-side scheduler).
# Default: http://127.0.0.1:$PORT
LYRA_INTERNAL_URL=
