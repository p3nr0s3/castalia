diff --git a/lib/rateLimit.ts b/lib/rateLimit.ts
new file mode 100644
index 0000000..6425156
--- /dev/null
+++ b/lib/rateLimit.ts
@@ -0,0 +1,65 @@
+/**
+ * Generic in-memory concurrency + burst guard, same pattern as
+ * lib/ollamaRateLimit.ts but parameterized so other routes (code execution,
+ * URL scanning) can get their own independent limiter instance without
+ * sharing state with the Ollama proxy's counters.
+ *
+ * Single-process, single-user app — resets on server restart. That's fine,
+ * this is a live guard against runaway loops/spam, not an audit log.
+ */
+
+export interface RateLimiterOptions {
+  maxConcurrent: number;
+  maxPerWindow: number;
+  windowMs: number;
+}
+
+export interface RateLimitResult {
+  allowed: boolean;
+  reason?: string;
+  retryAfterMs?: number;
+}
+
+export function createRateLimiter(options: RateLimiterOptions) {
+  let active = 0;
+  let windowStart = Date.now();
+  let windowCount = 0;
+
+  return {
+    tryAcquire(): RateLimitResult {
+      const now = Date.now();
+
+      if (now - windowStart > options.windowMs) {
+        windowStart = now;
+        windowCount = 0;
+      }
+
+      if (windowCount >= options.maxPerWindow) {
+        return {
+          allowed: false,
+          reason: `Rate limit exceeded: more than ${options.maxPerWindow} requests in ${options.windowMs / 1000}s.`,
+          retryAfterMs: options.windowMs - (now - windowStart),
+        };
+      }
+
+      if (active >= options.maxConcurrent) {
+        return {
+          allowed: false,
+          reason: `Too many concurrent requests (limit: ${options.maxConcurrent}). Wait for one to finish.`,
+        };
+      }
+
+      active++;
+      windowCount++;
+      return { allowed: true };
+    },
+
+    release(): void {
+      active = Math.max(0, active - 1);
+    },
+
+    status() {
+      return { active, maxConcurrent: options.maxConcurrent, windowCount, maxPerWindow: options.maxPerWindow };
+    },
+  };
+}
