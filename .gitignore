# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js build output
/.next/
/out/

# Production
/build

# Local Environment Variables
.env*.local
.env

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS Files
.DS_Store
*.pem
Thumbs.db

# Local SQLite databases & temporary files
*.sqlite
*.sqlite3
*.db
/data/*.sqlite
/data/*.db

# Personal chat/project data — contains real conversations and system prompts,
# should never be committed. Untracked as of this commit; file stays on disk.
/data/db.json
/data/db.json.migrated.bak
/data/embeddings-cache.json
/data/response-cache.json
/data/*.sqlite3-*

# Secret generated at Blender bridge install time — must never be committed.
/data/blender-bridge-token.json

# Session handoff patch files — accidentally committed 5 times (afc7d23,
# 070d1e2, 1022176, and twice more folded into other commits). Workflow is
# generate patch -> user applies -> delete before git add -A; this makes
# the "forgot to delete" case harmless too.
*.patch
*.diff
*.save
*.save.*

# graphify-generated code graph — local build artifact, rebuilt on demand
# by lib/graphifyOps.ts (once per server-process lifetime), not source.
/graphify-out/
.next/analyze/

# ---------------------------------------------------------------------------
# Private runtime data — NEVER commit. A copy of data/ named data-backup/ (with its
# SQLite WAL, i.e. real conversations and project files) was once committed to the
# public repo by `Copy-Item data data-backup`; these patterns, plus
# tests/repoHygiene.test.ts (which runs in CI), make that impossible to repeat.
# ---------------------------------------------------------------------------
/data/
/data-*/
/*-backup/
/*.git/
/lyra-clean*/
/*.bak/
*.sqlite3
*.sqlite3-*
*.sqlite-*
*.db-wal
*.db-shm
*-bridge-token.json
.env.local
.env.*.local
