# Personal chat/project data — contains real conversations and system prompts,
# should never be committed. Untracked as of this commit; file stays on disk.
/data/db.json
/data/db.json.migrated.bak
/data/*.sqlite3-*

# Secret generated at Blender bridge install time — must never be committed.
/data/blender-bridge-token.json

# Session handoff patch files — accidentally committed 5 times (afc7d23,
# 070d1e2, 1022176, and twice more folded into other commits). Workflow is
# generate patch -> user applies -> delete before git add -A; this makes
# the "forgot to delete" case harmless too.
*.patch
*.diff
